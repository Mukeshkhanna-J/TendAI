PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/tendai
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Local Ganache instance (run `npx ganache --port 7545 --chain.chainId 1337`
# from /blockchain, or the Ganache desktop app on the same port) and the
# TenderContract deployed to it (run `npx hardhat run scripts/deploy.js`
# from /blockchain — requires blockchain/.env with GANACHE_RPC_URL and
# GANACHE_PRIVATE_KEY). The server only ever reads from this contract —
# bidders write to it directly from their own connected wallet.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:7545
