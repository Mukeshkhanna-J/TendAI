PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/tendai
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Local blockchain node (run `npx hardhat node` in /blockchain) and the
# BidVerification contract deployed to it (run
# `npx hardhat run scripts/deployBidVerification.js --network localhost`
# in /blockchain). The server only ever reads from this contract — bidders
# write to it directly from their own MetaMask wallet in the browser.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BID_VERIFICATION_CONTRACT_ADDRESS=0x610178dA211FEF7D417bC0e6FeD39F05609AD788
