PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/tendai
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Local blockchain node (run `npx hardhat node` in /blockchain) and the
# BidVerification contract deployed to it (run
# `npx hardhat run scripts/deployBidVerification.js --network localhost`
# in /blockchain). Defaults below match a freshly started Hardhat node.
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BID_VERIFICATION_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
# Relayer account that pays gas for on-chain bid commits (Hardhat default account #0 - demo only)
BLOCKCHAIN_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
